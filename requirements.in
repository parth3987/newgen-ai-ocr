# Runtime dependencies (Phase 1). Pinned with hashes in requirements.lock.
# Regenerate with: make lock
# Every addition must be license-reviewed (docs/THIRD_PARTY_NOTICES.md).
fastapi
uvicorn
pydantic
pydantic-settings
# Phase 2: ingestion and PDF processing
pypdfium2
pillow
python-multipart
# Phase 3: image preprocessing and quality assessment.
# DEVELOPMENT ONLY: the PyPI wheel bundles EOL OpenSSL 1.1.1k and LGPL FFmpeg. Production
# uses a minimal source-built OpenCV (ADR-0015); the app refuses to start in production
# with an FFmpeg-enabled cv2. Pinned to 4.x (5.0 is a new major release).
opencv-python-headless<5
numpy
# Phase 4: OCR engines (ADR-0020). Official PaddleOCR stack, locked down for offline use:
# models load only from explicit local paths; hub SDKs it installs are never invoked.
paddleocr==3.7.0
# 3.2.2, not 3.3.1: 3.3.1's PIR+oneDNN executor fails on PP-OCRv5 detection and is ~5x
# slower without oneDNN (measured; ADR-0020).
paddlepaddle==3.2.2
# Phase 7: structured extraction export (Excel). MIT; pure Python (ADR-0026).
openpyxl
# Phase 9: database, migrations and background jobs (ADR-0029).
# psycopg is LGPL-3.0, used unmodified as a replaceable package (licence review in
# docs/THIRD_PARTY_NOTICES.md; owner-approved 2026-10-23). Pure-Python build loading the
# operating system's libpq (apt libpq5): psycopg-binary bundles end-of-life CentOS 7
# libraries (Kerberos, PCRE, SASL) and is not used (ADR-0029).
sqlalchemy
alembic
psycopg
celery[redis]
