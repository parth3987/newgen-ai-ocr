      "required": [
        "name",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "FieldType": {
      "enum": [
        "text",
        "name",
        "address",
        "identifier",
        "date",
        "amount",
        "number",
        "percent",
        "gstin",
        "pan",
        "aadhaar",
        "ifsc",
        "pincode",
        "phone",
        "gender"
      ],
      "title": "FieldType",
      "type": "string"
    },
    "Keyword": {
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "text"
      ],
      "title": "Keyword",
      "type": "object"
    },
    "PatternRule": {
      "properties": {
        "regex": {
          "title": "Regex",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "regex"
      ],
      "title": "PatternRule",
      "type": "object"
    },
    "TableSpec": {
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnSpec"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "summary_labels": {
          "default": [
            "total",
            "sub total",
            "subtotal",
            "grand total"
