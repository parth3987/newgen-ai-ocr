        "optional_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Optional Terms",
          "type": "array"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0.01",
