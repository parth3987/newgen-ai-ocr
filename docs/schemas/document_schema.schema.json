    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "title": "Fields",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "title": "Id",
      "type": "string"
    },
    "sections": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
