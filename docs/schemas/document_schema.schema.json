        "$ref": "#/$defs/TemplateSpec"
      },
      "title": "Templates",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "classification",
    "fields"
  ],
  "title": "DocumentSchema",
  "type": "object"
