            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "row_product",
            "column_sum",
            "field_sum",
            "equal",
            "date_order",
            "not_future",
            "gstin_pan",
            "gst_tax_type",
            "balance",
            "running_balance",
            "rows_within_period"
          ],
          "title": "Kind",
          "type": "string"
        },
        "negative_terms": {
          "default": [],
