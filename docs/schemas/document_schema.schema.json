          "items": {
            "type": "string"
          },
          "title": "Summary Labels",
          "type": "array"
        }
      },
      "required": [
        "name",
        "columns"
      ],
      "title": "TableSpec",
      "type": "object"
    },
    "TemplateSpec": {
      "description": "A known layout (e.g. one vendor's invoice): anchors identify it; regions locate fields.\n\nRegions are fractions of the page width/height: [x0, y0, x1, y1].",
      "properties": {
        "anchors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "regions": {
          "additionalProperties": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "default": {},
          "title": "Regions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "anchors"
      ],
      "title": "TemplateSpec",
      "type": "object"
    }
