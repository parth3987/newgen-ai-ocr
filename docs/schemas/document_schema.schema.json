            "$ref": "#/$defs/Keyword"
          },
          "title": "Keywords",
          "type": "array"
        },
        "min_score": {
          "default": 3.0,
          "title": "Min Score",
          "type": "number"
        },
        "patterns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PatternRule"
          },
          "title": "Patterns",
          "type": "array"
        },
        "table_headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Keyword"
          },
          "title": "Table Headers",
          "type": "array"
        }
      },
      "title": "ClassificationSpec",
      "type": "object"
    },
    "ColumnSpec": {
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Headers",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        }
      },
      "required": [
        "name",
        "type",
        "headers"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
    "FieldSpec": {
      "properties": {
        "block": {
          "anyOf": [
            {
              "enum": [
                "first",
                "rest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "max_lines": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "scan": {
          "default": false,
          "title": "Scan",
          "type": "boolean"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
