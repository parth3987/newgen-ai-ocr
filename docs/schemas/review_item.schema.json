{
  "$defs": {
    "AppliedCorrection": {
      "properties": {
        "action": {
          "enum": [
            "set",
            "confirm",
            "clear"
          ],
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous"
        },
        "reason": {
          "$ref": "#/$defs/CorrectionReason"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "location",
        "action",
        "reason",
        "actor",
        "at",
        "seq"
      ],
      "title": "AppliedCorrection",
      "type": "object"
    },
    "Assessment": {
      "properties": {
        "auto_accept_enabled": {
          "title": "Auto Accept Enabled",
          "type": "boolean"
        },
        "calibration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Id"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldDecision"
          },
          "title": "Fields",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TableDecision"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "calibration_id",
        "auto_accept_enabled",
        "eligible"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "CorrectionReason": {
      "enum": [
        "confirmed",
        "ocr_misread",
        "wrong_value_selected",
        "missed_value",
        "value_not_present",
        "ambiguity_resolved",
        "conflict_resolved",
        "normalisation_error",
        "other"
      ],
      "title": "CorrectionReason",
      "type": "string"
    },
    "Decision": {
      "properties": {
        "acknowledged_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Acknowledged Checks",
          "type": "array"
        },
        "action": {
          "enum": [
            "approved",
            "rejected",
            "auto_accepted"
          ],
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "action",
        "actor",
        "at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EngineAgreement": {
      "enum": [
        "agree",
        "disagree",
        "no_reading",
        "unavailable"
      ],
      "title": "EngineAgreement",
      "type": "string"
    },
    "EngineCheck": {
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "readings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Readings",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EngineAgreement"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "status"
      ],
      "title": "EngineCheck",
      "type": "object"
    },
    "FieldDecision": {
      "properties": {
        "calibration_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Key"
        },
        "checks_failed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks Failed",
          "type": "array"
        },
        "checks_passed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks Passed",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        },
        "engine": {
          "$ref": "#/$defs/EngineCheck",
          "default": {
            "engine": null,
            "readings": [],
            "status": "unavailable",
            "text": null
          }
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldReviewReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "type",
        "required",
        "status",
        "verified"
      ],
      "title": "FieldDecision",
      "type": "object"
    },
    "FieldReviewReason": {
      "enum": [
        "required_missing",
        "missing_unverified",
        "ambiguous",
        "conflict",
        "invalid",
        "not_calibrated",
        "below_threshold",
        "no_confidence",
        "engine_disagreement",
        "check_failed",
        "source_flagged",
        "document_type"
      ],
      "title": "FieldReviewReason",
      "type": "string"
    },
    "FieldStatus": {
      "enum": [
        "extracted",
        "missing",
        "ambiguous",
        "conflict",
        "invalid"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "ReviewItemStatus": {
      "enum": [
        "pending",
        "in_review",
        "approved",
        "rejected",
        "auto_accepted"
      ],
      "title": "ReviewItemStatus",
      "type": "string"
    },
    "TableDecision": {
      "properties": {
        "cells_flagged": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cells Flagged",
          "type": "array"
        },
        "checks_failed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks Failed",
          "type": "array"
        },
        "checks_passed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks Passed",
          "type": "array"
        },
        "engine_disagreements": {
          "default": 0,
          "title": "Engine Disagreements",
          "type": "integer"
        },
        "engine_disagreements_corroborated": {
          "default": 0,
          "title": "Engine Disagreements Corroborated",
          "type": "integer"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "table",
        "status",
        "verified"
      ],
      "title": "TableDecision",
      "type": "object"
    }
  },
  "properties": {
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "assigned_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned To"
    },
    "corrections": {
      "additionalProperties": {
        "$ref": "#/$defs/AppliedCorrection"
      },
      "default": {},
      "title": "Corrections",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "extraction_created_at": {
      "format": "date-time",
      "title": "Extraction Created At",
      "type": "string"
    },
    "layout_run": {
      "title": "Layout Run",
      "type": "string"
    },
    "priority": {
      "title": "Priority",
      "type": "integer"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schema Id"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schema Version"
    },
    "status": {
      "$ref": "#/$defs/ReviewItemStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "layout_run",
    "schema_id",
    "schema_version",
    "extraction_created_at",
    "status",
    "priority",
    "reasons",
    "assessment",
    "created_at",
    "updated_at"
  ],
  "title": "ReviewItem",
  "type": "object"
}
