# Copy to .env for local development. Placeholders only - never commit real values.
# All variables use the NGOCR_ prefix. See src/newgen_ocr/config.py.

# development | test | staging | production
NGOCR_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
NGOCR_LOG_LEVEL=INFO
# json | console
NGOCR_LOG_FORMAT=json
# Root of local document storage. Must exist and be writable (readiness check).
NGOCR_DATA_DIR=./data

# Ingestion limits
# JSON list, a subset of ["pdf","jpeg","png","tiff"]
NGOCR_ALLOWED_FORMATS=["pdf","jpeg","png","tiff"]
NGOCR_MAX_UPLOAD_BYTES=52428800
NGOCR_MAX_PAGES=200
NGOCR_MAX_PAGE_PIXELS=80000000

# PDF processing
NGOCR_RENDER_DPI=300
NGOCR_NATIVE_TEXT_MIN_CHARS=20

# Preprocessing
# none | standard | degraded_scan | photo | binarize | <custom>
NGOCR_DEFAULT_PREPROCESSING_PROFILE=standard
# JSON list of extra profiles, e.g. [{"name":"fax","denoise":"always","adaptive_threshold":true}]
NGOCR_CUSTOM_PREPROCESSING_PROFILES=[]
# Threads per process (unset = OpenCV default). Use 1 when running several workers.
# NGOCR_OPENCV_THREADS=1

# OCR (models are only read locally; fetch at staging with `make models`)
NGOCR_MODELS_DIR=./models
NGOCR_MODELS_LOCK=./models.lock.json
NGOCR_OCR_PRIMARY_ENGINE=paddle
NGOCR_OCR_FALLBACK_ENGINE=tesseract
NGOCR_OCR_DEFAULT_LANGUAGES=["en"]
NGOCR_OCR_LANGUAGE_PRIMARY={"kn": "tesseract"}
NGOCR_PADDLE_DETECTION_MODEL=PP-OCRv5_mobile_det
NGOCR_PADDLE_ENABLE_MKLDNN=true
# NGOCR_OCR_CPU_THREADS=4
NGOCR_TESSERACT_CMD=tesseract
NGOCR_OCR_PAGE_TIMEOUT_S=300
NGOCR_OCR_DISAGREEMENT_THRESHOLD=0.85
