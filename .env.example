# Copy to .env for local development. Placeholders only - never commit real values.
# All variables use the NGOCR_ prefix. See src/newgen_ocr/config.py.

# development | test | staging | production
NGOCR_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
NGOCR_LOG_LEVEL=INFO
# json | console
NGOCR_LOG_FORMAT=json
# Root of local document storage. Must exist and be writable (readiness check).
NGOCR_DATA_DIR=./data

# Ingestion limits
# JSON list, a subset of ["pdf","jpeg","png","tiff"]
NGOCR_ALLOWED_FORMATS=["pdf","jpeg","png","tiff"]
NGOCR_MAX_UPLOAD_BYTES=52428800
NGOCR_MAX_PAGES=200
NGOCR_MAX_PAGE_PIXELS=80000000

# PDF processing
NGOCR_RENDER_DPI=300
NGOCR_NATIVE_TEXT_MIN_CHARS=20
