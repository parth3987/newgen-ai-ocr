# Site settings for an installed New Gen AI OCR (ADR-0032). `ngocrctl install` writes
# <prefix>/config/site.env from this template on the first install and never overwrites it;
# upgrades and rollbacks keep it. Compose reads it with --env-file. Placeholders only.

# Where the secret files live (created by the installer, owner-only directory).
NGOCR_SECRETS_PATH=/opt/newgen-ocr/config/secrets
# Backups taken by `ngocrctl backup` and before every upgrade.
NGOCR_BACKUP_DIR=/opt/newgen-ocr/backups

# HTTPS: the only published port. Bind to the host's internal address to serve the network.
NGOCR_HTTPS_BIND=127.0.0.1
NGOCR_HTTPS_PORT=8443
# The name on the server certificate; the smoke test checks the certificate for it.
NGOCR_TLS_HOSTNAME=localhost

NGOCR_LOG_LEVEL=INFO
# Background OCR: processes per worker container, threads per process, and the container's
# limits (about 2 GiB per process).
NGOCR_WORKER_CONCURRENCY=1
NGOCR_OCR_CPU_THREADS=2
NGOCR_WORKER_MEMORY=6g
NGOCR_WORKER_CPUS=2.0
